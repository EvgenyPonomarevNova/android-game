* text=auto eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
# Imported skill hashes describe exact upstream bytes, including line endings.
/.agents/** -text
# Preserve provided artwork and upstream licence bytes, including whitespace.
/assets/inbox/** -text whitespace=-blank-at-eol,-blank-at-eof
/docs/skill-licenses/** -text whitespace=-blank-at-eol,-blank-at-eof
*.png binary
*.jpg binary
*.webp binary
*.ogg binary
*.wav binary
*.glb binary
*.blend binary
*.psd binary
