root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.ps1]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Preserve imported material byte-for-byte for provenance verification.
[.agents/**]
insert_final_newline = unset
trim_trailing_whitespace = false
end_of_line = unset
charset = unset
