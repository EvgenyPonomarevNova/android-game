{
  "name": "nerazley",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests/*.test.ts *.ts",
    "format": "prettier --write src tests/*.test.ts *.ts package.json package-lock.json tsconfig.json .prettierrc.json index.html",
    "format:check": "prettier --check src tests/*.test.ts *.ts package.json package-lock.json tsconfig.json .prettierrc.json index.html",
    "test": "vitest run",
    "level:new": "node tools/level-cli.mjs new",
    "level:check": "node tools/level-cli.mjs check",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "pwsh -NoProfile -File tools/build-android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/preferences": "8.0.1",
    "@fontsource-variable/onest": "5.3.1",
    "phaser": "4.2.1",
    "planck": "1.5.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
